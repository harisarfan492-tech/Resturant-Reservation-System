    {
      "parameters": {
        "jsCode": "\nconst request = $('Edit Fields').first().json;\nconst bookings = $input.all().map(item => item.json);\n\n// Normalize spreadsheet headers by removing whitespace/newlines\nfunction normalizeRow(row) {\n  const normalized = {};\n\n  for (const [key, value] of Object.entries(row)) {\n    normalized[key.trim()] = value;\n  }\n\n  return normalized;\n}\n\nconst normalizedBookings = bookings.map(normalizeRow);\n\nconst date = String(\n  request['Date of Reservation'] ?? ''\n).slice(0, 10);\n\nfunction normalizeTime(value) {\n  const match = String(value ?? '').trim().match(/^(\\d{1,2}):(\\d{2})/);\n\n  if (!match) return String(value ?? '').trim();\n\n  return `${match[1].padStart(2, '0')}:${match[2]}`;\n}\n\nconst time = normalizeTime(request['Time of Reservation']);\n\nif (!date || !time) {\n  throw new Error('Date or time is missing from the form.');\n}\n\nconst conflict = normalizedBookings.some(booking => {\n  const existingDate = String(booking.date ?? '').slice(0, 10);\n  const existingTime = normalizeTime(booking.time);\n  const status = String(booking.status ?? '').trim().toLowerCase();\n\n  return (\n    existingDate === date &&\n    existingTime === time &&\n    ['pending', 'confirmed'].includes(status)\n  );\n});\n\nreturn [{\n  json: {\n    ...request,\n    date,\n    time,\n    available: !conflict,\n    availability_message: conflict\n      ? 'That date and time already has a pending or confirmed reservation.'\n      : 'No matching reservation was found.'\n  }\n}];\n"
      },
